# Local dev settings for the API server (api/dev-server.ts). Copy to .env.local.

# Token for /admin/visits?token=...
ADMIN_TOKEN=dev-token

# Leave unset to keep visits in memory. Set (after `npm run db:up`) to use DynamoDB Local.
# DYNAMODB_ENDPOINT=http://localhost:8000
VISITS_TABLE=personal-site-local-visits
